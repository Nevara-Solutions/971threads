<script>
  (function() {
    class WhatsAppChat{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-whatsapp-chat-button-{{ ai_gen_id }}');
        this.popup = this.querySelector('.ai-whatsapp-chat-popup-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-whatsapp-chat-popup-close-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => {
          this.togglePopup();
        });

        this.closeButton.addEventListener('click', (e) => {
          e.stopPropagation();
          this.closePopup();
        });

        document.addEventListener('click', (e) => {
          if (!this.contains(e.target)) {
            this.closePopup();
          }
        });
      }

      togglePopup() {
        const isActive = this.popup.classList.contains('active');
        if (isActive) {
          this.closePopup();
        } else {
          this.openPopup();
        }
      }

      openPopup() {
        this.popup.classList.add('active');
        this.button.setAttribute('aria-expanded', 'true');
      }

      closePopup() {
        this.popup.classList.remove('active');
        this.button.setAttribute('aria-expanded', 'false');
      }
    }

    customElements.define('whatsapp-chat-{{ ai_gen_id }}', WhatsAppChat{{ ai_gen_id }});
  })();
</script>

