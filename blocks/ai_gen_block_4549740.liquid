{% doc %}
  @prompt
    A high-end, modern UI design section for a Shopify store homepage, showcasing customer reviews from Google. The design should feature the brand logo '971 Threads'. The section's title is 'WHAT OUR COMMUNITY SAYS'. 30 distinct review cards are displayed in a clean row. Each card must include: 5 gold star icons, a profile picture of the customer, the customer's name, a short review text (e.g., 'Best streetwear in Dubai!'), and a small Google 'Verified Review' badge. The style is minimalist and clean with a touch of gold accent colors against a white background. The layout must be fully responsive, showing how it adapts from desktop to a mobile stack. Studio lighting, high resolution.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-reviews-logo-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-reviews-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-reviews-logo-placeholder-{{ ai_gen_id }} {
    display: inline-block;
    background-color: #f4f4f4;
    padding: 20px 40px;
    border-radius: 8px;
  }

  .ai-reviews-logo-placeholder-{{ ai_gen_id }} svg {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    max-height: 60px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    letter-spacing: 2px;
    color: {{ block.settings.title_color }};
    margin: 0;
    text-transform: uppercase;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.accent_color }} #f0f0f0;
    padding-bottom: 20px;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 4px;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.accent_color }};
    border-radius: 4px;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    padding: 10px 0;
  }

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.accent_color }};
  }

  .ai-review-profile-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #f4f4f4;
  }

  .ai-review-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
  }

  .ai-review-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    flex-grow: 1;
  }

  .ai-review-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #5f6368;
  }

  .ai-google-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
      letter-spacing: 1px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 280px;
    }

    .ai-reviews-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }
  }
{% endstyle %}

<google-reviews-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      <div class="ai-reviews-logo-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ block.settings.logo.alt | default: '971 Threads' | escape }}"
            width="{{ block.settings.logo_width }}"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <div class="ai-reviews-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    </div>

    <div class="ai-reviews-scroll-wrapper-{{ ai_gen_id }}">
      <div class="ai-reviews-grid-{{ ai_gen_id }}">
        {% for i in (1..30) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_image_key = 'review_' | append: i | append: '_image'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_name = block.settings[review_name_key]
            assign review_text = block.settings[review_text_key]
            assign review_image = block.settings[review_image_key]
          %}

          {% if review_enabled %}
            <div class="ai-review-card-{{ ai_gen_id }}">
              <div class="ai-review-stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <svg class="ai-review-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              <div class="ai-review-profile-{{ ai_gen_id }}">
                <div class="ai-review-avatar-{{ ai_gen_id }}">
                  {% if review_image %}
                    <img
                      src="{{ review_image | image_url: width: 100 }}"
                      alt="{{ review_name | escape }}"
                      width="100"
                      height="100"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="ai-review-avatar-placeholder-{{ ai_gen_id }}">
                      {{ review_name | slice: 0 | upcase }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-review-name-{{ ai_gen_id }}">{{ review_name }}</h3>
              </div>

              <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>

              <div class="ai-review-badge-{{ ai_gen_id }}">
                <svg class="ai-google-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Verified Review</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</google-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class GoogleReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollWrapper = this.querySelector('.ai-reviews-scroll-wrapper-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.scrollWrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.scrollWrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          this.scrollWrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.scrollWrapper.offsetLeft;
          scrollLeft = this.scrollWrapper.scrollLeft;
        });

        this.scrollWrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.scrollWrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.scrollWrapper.scrollLeft = scrollLeft - walk;
        });

        this.scrollWrapper.style.cursor = 'grab';
      }
    }

    customElements.define('google-reviews-{{ ai_gen_id }}', GoogleReviews{{ ai_gen_id }});
  })();
</script>

