{% doc %}
  @prompt
    "Act as a Shopify developer. I need a 'Social Media Feed' section with the following advanced requirements:
    
    7 Video Slots: Create a section that supports exactly 7 slots for video embed codes (Instagram/TikTok).
    
    Desktop Layout: Show the videos in a clean grid (e.g., 3 or 4 columns) on desktop.
    
    Mobile Carousel (Crucial): On mobile devices, the videos must not stack vertically. Instead, they must be displayed in a horizontal carousel (slider) that allows the user to swipe left and right.
    
    Responsiveness: Ensure the horizontal scroll is smooth and hidden scrollbars are used for a cleaner look on mobile.
    
    Shopify Schema: Include Shopify Liquid schema settings so I can add 7 unique embed codes directly through the Theme Customizer without editing the code manually.
    
    CSS: Use scoped CSS to ensure the carousel doesn't conflict with the theme. Please provide the code in a single 'Custom Liquid' format."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-feed-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 0;
  }

  .ai-social-feed-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-social-feed-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-social-feed-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-social-feed-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-social-feed-item-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-social-feed-empty-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    color: #999;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-social-feed-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.mobile_gap }}px;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-social-feed-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-social-feed-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_width }}%;
      scroll-snap-align: start;
    }

    .ai-social-feed-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<social-feed-{{ ai_gen_id }} class="ai-social-feed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-feed-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-social-feed-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-social-feed-grid-{{ ai_gen_id }}">
      {% for i in (1..7) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign video_embed = block.settings[video_key]
        %}

        <div class="ai-social-feed-item-{{ ai_gen_id }}">
          {% if video_embed != blank %}
            {{ video_embed }}
          {% else %}
            <div class="ai-social-feed-empty-{{ ai_gen_id }}">
              Add video {{ i }} embed code
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</social-feed-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialFeed{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.grid = this.querySelector('.ai-social-feed-grid-{{ ai_gen_id }}');
        this.setupMobileCarousel();
      }

      setupMobileCarousel() {
        if (window.innerWidth <= 749) {
          this.grid.addEventListener('scroll', this.handleScroll.bind(this));
        }

        window.addEventListener('resize', () => {
          if (window.innerWidth <= 749) {
            this.grid.addEventListener('scroll', this.handleScroll.bind(this));
          }
        });
      }

      handleScroll() {
        const scrollLeft = this.grid.scrollLeft;
        const scrollWidth = this.grid.scrollWidth;
        const clientWidth = this.grid.clientWidth;
      }
    }

    customElements.define('social-feed-{{ ai_gen_id }}', SocialFeed{{ ai_gen_id }});
  })();
</script>

