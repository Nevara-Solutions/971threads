{% doc %}
  @prompt
    "Act as a Shopify developer. I want to add a 'Social Feed' section to my Shopify homepage that showcases my Instagram Reels and TikTok videos.
    
    Requirements:
    
    Layout: A grid-style layout for desktop (e.g., 4 columns) and a slider or grid layout for mobile that allows users to swipe through 5–10 videos.
    
    Responsiveness: It MUST be fully responsive. Videos should maintain their aspect ratio on mobile without breaking the layout.
    
    Functionality: >    - Embed videos from Instagram and TikTok directly.
    
    Ensure the layout is clean, minimalist, and matches a streetwear aesthetic.
    
    Add a 'Play' overlay icon so users know they are clickable videos.
    
    Shopify Integration: Provide the code as a 'Custom Liquid' section so I can easily add it to my theme without needing external paid apps.
    
    User Experience: Ensure it loads efficiently (lazy loading) so it doesn't slow down my website speed.
    
    Schema: Include Shopify Schema settings so I can easily update the video links in the Theme Customizer."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-feed-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-social-feed-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-social-feed-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-social-feed-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-social-feed-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-social-feed-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-social-feed-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
    background-color: #000;
    cursor: pointer;
  }

  .ai-social-feed-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-social-feed-video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-social-feed-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  .ai-social-feed-play-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: {{ block.settings.play_button_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: {{ block.settings.play_button_opacity }};
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    z-index: 2;
  }

  .ai-social-feed-item-{{ ai_gen_id }}:hover .ai-social-feed-play-overlay-{{ ai_gen_id }} {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-social-feed-play-icon-{{ ai_gen_id }} {
    width: 0;
    height: 0;
    border-left: 18px solid {{ block.settings.play_icon_color }};
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    margin-left: 4px;
  }

  .ai-social-feed-platform-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 2;
  }

  @media screen and (max-width: 989px) {
    .ai-social-feed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-social-feed-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
    }

    .ai-social-feed-item-{{ ai_gen_id }} {
      flex: 0 0 280px;
      scroll-snap-align: start;
    }

    .ai-social-feed-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-social-feed-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<social-feed-{{ ai_gen_id }} class="ai-social-feed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-feed-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-social-feed-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-social-feed-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-social-feed-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-social-feed-grid-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign video_url_key = 'video_url_' | append: i
          assign platform_key = 'platform_' | append: i
          assign video_url = block.settings[video_url_key]
          assign platform = block.settings[platform_key]
        %}

        {% if video_url != blank %}
          <div class="ai-social-feed-item-{{ ai_gen_id }}" data-video-index="{{ i }}">
            {% if block.settings.show_platform_badge %}
              <div class="ai-social-feed-platform-badge-{{ ai_gen_id }}">
                {% if platform == 'instagram' %}
                  Instagram
                {% elsif platform == 'tiktok' %}
                  TikTok
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-social-feed-video-wrapper-{{ ai_gen_id }}">
              {% if platform == 'instagram' %}
                <iframe
                  src="{{ video_url }}"
                  frameborder="0"
                  scrolling="no"
                  allowtransparency="true"
                  loading="lazy"
                ></iframe>
              {% elsif platform == 'tiktok' %}
                <iframe
                  src="{{ video_url }}"
                  frameborder="0"
                  scrolling="no"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% endif %}
            </div>

            {% if block.settings.show_play_overlay %}
              <div class="ai-social-feed-play-overlay-{{ ai_gen_id }}">
                <div class="ai-social-feed-play-icon-{{ ai_gen_id }}"></div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</social-feed-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialFeed{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videoItems = this.querySelectorAll('.ai-social-feed-item-{{ ai_gen_id }}');
        this.setupLazyLoading();
      }

      setupLazyLoading() {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const iframe = entry.target.querySelector('iframe');
                if (iframe && !iframe.src) {
                  iframe.src = iframe.dataset.src;
                }
                observer.unobserve(entry.target);
              }
            });
          }, {
            rootMargin: '50px'
          });

          this.videoItems.forEach((item) => {
            observer.observe(item);
          });
        }
      }
    }

    customElements.define('social-feed-{{ ai_gen_id }}', SocialFeed{{ ai_gen_id }});
  })();
</script>

