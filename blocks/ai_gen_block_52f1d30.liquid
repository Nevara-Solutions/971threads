{% doc %}
  @prompt
    Act as a Shopify Liquid and CSS expert. Please redesign my store's footer to be more professional, conversion-focused, and fully responsive.
    
    Requirements:
    
    Layout: Create a 4-column desktop layout:
    
    Column 1: Logo, brand description, and social media icons.
    
    Column 2: Quick Links (Collections, About, Contact, FAQ).
    
    Column 3: Customer Service & Policies (Shipping Policy, Returns, Privacy Policy, Terms of Service).
    
    Column 4: Newsletter signup with a clear input field and 'Subscribe' button.
    
    Footer Bottom Bar: Add a bottom section for copyright info and a dynamic list of payment method icons (e.g., Visa, Mastercard, AMEX, Apple Pay).
    
    Responsiveness:
    
    Desktop: Grid layout.
    
    Mobile: Use an accordion-style toggle for links so the user doesn't have to scroll through an overly long page.
    
    Shopify Schema: Please include the necessary Liquid schema settings so I can easily edit the text, links, and social media URLs directly from the Shopify Theme Customizer.
    
    Styling: Maintain a clean, premium streetwear aesthetic consistent with my brand (971 Threads). Use appropriate spacing, font sizes, and hover effects for links.
    
    Implementation: Provide the complete code including HTML, Liquid, and CSS. Please ensure the code is scoped to avoid interfering with my existing theme's global styles."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: 60px 0 0;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-brand-description-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.social_bg_color }};
    border-radius: 50%;
    color: {{ block.settings.social_icon_color }};
    transition: all 0.3s ease;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.social_hover_bg_color }};
    color: {{ block.settings.social_hover_icon_color }};
    transform: translateY(-2px);
  }

  .ai-footer-social-link-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    transform: translateX(4px);
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .ai-footer-newsletter-message-{{ ai_gen_id }} {
    font-size: 13px;
    margin-top: 8px;
  }

  .ai-footer-newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-footer-newsletter-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-footer-payment-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 30px;
    background: #ffffff;
    border-radius: 5px;
    padding: 4px 5px;
    box-sizing: border-box;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} img,
  .ai-footer-payment-icon-{{ ai_gen_id }} svg {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  /* Amex: show the blue badge itself, no white chip around it. */
  .ai-footer-pay-bare-{{ ai_gen_id }} {
    background: transparent;
    padding: 0;
  }
  .ai-footer-pay-bare-{{ ai_gen_id }} svg {
    max-width: 100%;
    max-height: 100%;
    border-radius: 5px;
  }

  /* Apple Pay: white box, no padding, black border. */
  .ai-footer-pay-applepay-{{ ai_gen_id }} {
    padding: 0;
    background: #ffffff;
    border: 1px solid #000000;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-footer-accordion-toggle-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-footer-{{ ai_gen_id }} {
      padding: 40px 0 0;
    }

    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0;
      border-bottom: none;
    }

    .ai-footer-column-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      grid-column: 1;
      padding-bottom: 30px;
      border-bottom: 1px solid {{ block.settings.border_color }};
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child) {
      border-bottom: 1px solid {{ block.settings.border_color }};
      padding: 20px 0;
    }

    .ai-footer-accordion-toggle-{{ ai_gen_id }} {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: {{ block.settings.heading_color }};
    }

    .ai-footer-accordion-icon-{{ ai_gen_id }} {
      width: 20px;
      height: 20px;
      transition: transform 0.3s ease;
    }

    .ai-footer-accordion-icon-{{ ai_gen_id }}.active {
      transform: rotate(180deg);
    }

    .ai-footer-accordion-content-{{ ai_gen_id }} {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .ai-footer-accordion-content-{{ ai_gen_id }}.active {
      max-height: 500px;
      padding-top: 16px;
    }

    .ai-footer-bottom-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      padding: 30px 0;
    }

    .ai-footer-payment-icons-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-footer-newsletter-form-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            class="ai-footer-logo-{{ ai_gen_id }}"
            width="{{ block.settings.logo_width }}"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <h2 class="ai-footer-heading-{{ ai_gen_id }}">{{ shop.name }}</h2>
        {% endif %}

        {% if block.settings.brand_description != blank %}
          <div class="ai-footer-brand-description-{{ ai_gen_id }}">
            {{ block.settings.brand_description }}
          </div>
        {% endif %}

        <div class="ai-footer-social-{{ ai_gen_id }}">
          {% if block.settings.social_instagram != blank %}
            <a
              href="{{ block.settings.social_instagram }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_facebook != blank %}
            <a
              href="{{ block.settings.social_facebook }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_twitter != blank %}
            <a
              href="{{ block.settings.social_twitter }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="Twitter"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_tiktok != blank %}
            <a
              href="{{ block.settings.social_tiktok }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="TikTok"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"></path>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.social_youtube != blank %}
            <a
              href="{{ block.settings.social_youtube }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener"
              aria-label="YouTube"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#fff"></polygon>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <button
          class="ai-footer-accordion-toggle-{{ ai_gen_id }}"
          aria-expanded="false"
          data-accordion-toggle
        >
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          <svg class="ai-footer-accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="ai-footer-accordion-content-{{ ai_gen_id }}">
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.link_2_1_text != blank and block.settings.link_2_1_url != blank %}
              <li>
                <a href="{{ block.settings.link_2_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_2_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_2_2_text != blank and block.settings.link_2_2_url != blank %}
              <li>
                <a href="{{ block.settings.link_2_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_2_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_2_3_text != blank and block.settings.link_2_3_url != blank %}
              <li>
                <a href="{{ block.settings.link_2_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_2_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_2_4_text != blank and block.settings.link_2_4_url != blank %}
              <li>
                <a href="{{ block.settings.link_2_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_2_4_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_2_5_text != blank and block.settings.link_2_5_url != blank %}
              <li>
                <a href="{{ block.settings.link_2_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_2_5_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <button
          class="ai-footer-accordion-toggle-{{ ai_gen_id }}"
          aria-expanded="false"
          data-accordion-toggle
        >
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
          <svg class="ai-footer-accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="ai-footer-accordion-content-{{ ai_gen_id }}">
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.link_3_1_text != blank and block.settings.link_3_1_url != blank %}
              <li>
                <a href="{{ block.settings.link_3_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_3_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_3_2_text != blank and block.settings.link_3_2_url != blank %}
              <li>
                <a href="{{ block.settings.link_3_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_3_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_3_3_text != blank and block.settings.link_3_3_url != blank %}
              <li>
                <a href="{{ block.settings.link_3_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_3_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_3_4_text != blank and block.settings.link_3_4_url != blank %}
              <li>
                <a href="{{ block.settings.link_3_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_3_4_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.link_3_5_text != blank and block.settings.link_3_5_url != blank %}
              <li>
                <a href="{{ block.settings.link_3_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ block.settings.link_3_5_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>

        {%- form 'customer', class: 'ai-footer-newsletter-form-wrapper' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          <div class="ai-footer-newsletter-form-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-footer-newsletter-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.newsletter_placeholder }}"
              aria-label="Email address"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="newsletter-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="newsletter-success-{{ ai_gen_id }}"
              {% endif %}
            >
            <button
              type="submit"
              class="ai-footer-newsletter-button-{{ ai_gen_id }}"
            >
              {{ block.settings.newsletter_button_text }}
            </button>
          </div>

          {%- if form.errors -%}
            <div
              id="newsletter-error-{{ ai_gen_id }}"
              class="ai-footer-newsletter-message-{{ ai_gen_id }} ai-footer-newsletter-error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div
              id="newsletter-success-{{ ai_gen_id }}"
              class="ai-footer-newsletter-message-{{ ai_gen_id }} ai-footer-newsletter-success-{{ ai_gen_id }}"
            >
              {{ block.settings.newsletter_success_message }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="ai-footer-bottom-{{ ai_gen_id }}">
      <div class="ai-footer-copyright-{{ ai_gen_id }}">
        {{ block.settings.copyright_text }}
      </div>

      <div class="ai-footer-payment-icons-{{ ai_gen_id }}">
        {% if block.settings.show_visa %}
          <span class="ai-footer-payment-icon-{{ ai_gen_id }}"><img src="{{ 'payment-visa.svg' | asset_url }}" alt="Visa" width="40" height="26" loading="lazy"></span>
        {% endif %}
        {% if block.settings.show_mastercard %}
          <span class="ai-footer-payment-icon-{{ ai_gen_id }}"><img src="{{ 'payment-mastercard.svg' | asset_url }}" alt="Mastercard" width="40" height="26" loading="lazy"></span>
        {% endif %}
        {% if block.settings.show_amex %}
          <span class="ai-footer-payment-icon-{{ ai_gen_id }} ai-footer-pay-bare-{{ ai_gen_id }}">{{ 'american_express' | payment_type_svg_tag }}</span>
        {% endif %}
        {% if block.settings.show_apple_pay %}
          <span class="ai-footer-payment-icon-{{ ai_gen_id }} ai-footer-pay-applepay-{{ ai_gen_id }}">{{ 'apple_pay' | payment_type_svg_tag }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</footer-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.accordionToggles = this.querySelectorAll('[data-accordion-toggle]');
        this.setupAccordions();
      }

      setupAccordions() {
        this.accordionToggles.forEach((toggle) => {
          const content = toggle.nextElementSibling;
          const icon = toggle.querySelector('.ai-footer-accordion-icon-{{ ai_gen_id }}');

          toggle.addEventListener('click', () => {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            
            toggle.setAttribute('aria-expanded', !isExpanded);
            content.classList.toggle('active');
            icon.classList.toggle('active');
          });
        });
      }
    }

    customElements.define('footer-block-{{ ai_gen_id }}', FooterBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Professional footer",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
