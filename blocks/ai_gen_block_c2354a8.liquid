{% doc %}
  @prompt
    Act as a Shopify Liquid and CSS expert. Please provide a clean, production-ready implementation for a FAQ section that matches the style shown in the provided reference.
    
    Requirements:
    
    Design: Use a minimalist design with a thin border around each FAQ item, bold typography for the questions, and clean, readable body text for the answers.
    
    Functionality: Implement an accordion-style drop-down where clicking the question toggles the visibility of the answer. Use a small caret/chevron icon (up/down) to indicate if it is open or closed.
    
    Responsiveness: Ensure the FAQ section is fully mobile-responsive. On mobile, the text should wrap correctly, and padding should adjust automatically for smaller screens without breaking the layout.
    
    Schema Integration: Include the necessary Shopify Liquid schema settings so I can add and edit the FAQ questions and answers directly from the Shopify Theme Customizer.
    
    Technical: Please provide the code as a single block including the Liquid, HTML, CSS, and minimal JavaScript required for the accordion functionality. Use scoped CSS classes to avoid conflicts with existing theme styles."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-faq-accordion__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.spacing_above_items }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-faq-accordion__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing_between_items }}px;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }} {
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.item_background_color }};
  }

  .ai-faq-accordion__button-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.item_padding }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }

  .ai-faq-accordion__question-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    font-weight: 700;
    color: {{ block.settings.question_color }};
    margin: 0;
    flex: 1;
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }}.active .ai-faq-accordion__icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-accordion__answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-accordion__answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.item_padding }}px {{ block.settings.item_padding }}px;
    font-size: {{ block.settings.answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.answer_color }};
  }

  .ai-faq-accordion__answer-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-faq-accordion__answer-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-faq-accordion__question-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }

    .ai-faq-accordion__answer-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.answer_size }}px * 0.95);
    }

    .ai-faq-accordion__button-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.75 }}px;
    }

    .ai-faq-accordion__answer-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.item_padding | times: 0.75 }}px {{ block.settings.item_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-faq-accordion__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <ul class="ai-faq-accordion__list-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign answer_key = 'answer_' | append: i
        assign question = block.settings[question_key]
        assign answer = block.settings[answer_key]
      %}

      {% if question != blank and answer != blank %}
        <li class="ai-faq-accordion__item-{{ ai_gen_id }}" data-faq-item>
          <button
            class="ai-faq-accordion__button-{{ ai_gen_id }}"
            aria-expanded="false"
            data-faq-button
          >
            <h3 class="ai-faq-accordion__question-{{ ai_gen_id }}">{{ question }}</h3>
            <span class="ai-faq-accordion__icon-{{ ai_gen_id }}" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="ai-faq-accordion__answer-wrapper-{{ ai_gen_id }}" data-faq-answer>
            <div class="ai-faq-accordion__answer-{{ ai_gen_id }}">
              {{ answer }}
            </div>
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('[data-faq-button]');
          const answerWrapper = item.querySelector('[data-faq-answer]');

          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');

            if (isActive) {
              this.closeItem(item, button, answerWrapper);
            } else {
              this.openItem(item, button, answerWrapper);
            }
          });
        });
      }

      openItem(item, button, answerWrapper) {
        item.classList.add('active');
        button.setAttribute('aria-expanded', 'true');
        answerWrapper.style.maxHeight = answerWrapper.scrollHeight + 'px';
      }

      closeItem(item, button, answerWrapper) {
        item.classList.remove('active');
        button.setAttribute('aria-expanded', 'false');
        answerWrapper.style.maxHeight = '0';
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

