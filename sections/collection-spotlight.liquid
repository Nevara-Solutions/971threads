{%- comment -%}
  971threads — Collection spotlight.
  Berlin-style: editorial text panel on the left, horizontal-scrolling product row on the right.
  Pure CSS scroll-snap slider (no JS). Pulls from a chosen collection; shows onboarding
  placeholders if none is set yet. Description is a textarea (plain text — no richtext <p> gotcha).
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

{{ 'quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-view.js' | asset_url }}" defer></script>

{%- style -%}
  #cspot-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="cspot-{{ section.id }}" class="cspot cspot--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient">
  <div class="cspot__grid">
    <div class="cspot__intro">
      <div class="cspot__intro-text">
        {%- if section.settings.kicker != blank -%}
          <p class="cspot__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cspot__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="cspot__desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: coll.url | default: '#' }}" class="cspot__btn">
          <span>{{ section.settings.button_label }}</span>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="square"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="cspot__row">
      {%- if coll != blank and coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          <div class="cspot__card">
            <div class="cspot__media">
              <a href="{{ product.url }}" class="cspot__media-link" aria-label="{{ product.title | escape }}">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', widths: '300, 500, 700, 800', class: 'cspot__img cspot__img--primary', alt: product.title
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'cspot__img placeholder' }}
                {%- endif -%}
              </a>
              {%- if product.compare_at_price > product.price -%}
                <span class="cspot__badge">Sale</span>
              {%- endif -%}
              <button type="button" class="cspot__qv" data-quick-view data-product-url="{{ product.url }}">Quick view</button>
            </div>
            <a href="{{ product.url }}" class="cspot__info">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="cspot__vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h3 class="cspot__title">{{ product.title }}</h3>
              <p class="cspot__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="cspot__price-sale">{{ product.price | money }}</span>
                  <s class="cspot__price-was">{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </p>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="cspot__card cspot__card--placeholder">
            <div class="cspot__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'cspot__img placeholder' }}</div>
            <div class="cspot__info">
              <h3 class="cspot__title">Product title</h3>
              <p class="cspot__price">AED 0.00</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .cspot__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
    padding-inline: var(--page-gutter);
  }
  .cspot__intro {
    padding-inline: 0;
  }
  .cspot__kicker {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 1.2rem;
    font-weight: 600;
    opacity: 0.7;
  }
  .cspot__heading {
    margin: 0 0 1.4rem;
    font-family: var(--font-heading-family);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: -0.01em;
    font-size: clamp(3rem, 3.6vw, 4.6rem);
  }
  .cspot__desc {
    margin: 0 0 2.4rem;
    max-width: 42ch;
    opacity: 0.8;
    line-height: 1.5;
  }
  .cspot__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.3rem 2.6rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border: 1.5px solid rgb(var(--color-foreground));
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    font-size: 1.3rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .cspot__btn:hover { background: #fff; color: #000; border-color: #000; }

  /* "Top" layout: heading row + link on top, full-width slider below (sale section). */
  .cspot--top .cspot__grid { display: block; }
  .cspot--top .cspot__intro {
    position: static;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.6rem 2rem;
    margin-bottom: 3rem;
  }
  .cspot--top .cspot__heading { margin-bottom: 0; }
  .cspot--top .cspot__desc { display: none; }
  .cspot--top .cspot__btn {
    background: transparent;
    color: inherit;
    border: none;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.5rem;
  }
  .cspot--top .cspot__btn svg { display: none; }
  .cspot--top .cspot__btn:hover { background: transparent; color: inherit; opacity: 0.65; }

  .cspot__row {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;
    scrollbar-width: none; /* hide scrollbar (Firefox) */
  }
  .cspot__row::-webkit-scrollbar { display: none; } /* hide scrollbar (WebKit) */
  .cspot__card {
    flex: 0 0 auto;
    width: 80vw;
    max-width: 34rem;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
  }
  .cspot__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
    margin-bottom: 1.2rem;
  }
  .cspot__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cspot__img--primary { transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cspot__card:hover .cspot__img--primary { transform: scale(1.07); }
  .cspot__media-link { position: absolute; inset: 0; z-index: 1; display: block; }
  .cspot__info { display: block; text-decoration: none; color: inherit; }
  .cspot__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    background: rgba(17, 17, 17, 0.9);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1.1rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
  }
  .cspot__qv {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    border: none;
    cursor: pointer;
    background: rgba(17, 17, 17, 0.92);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-size: 1.3rem;
    padding: 1.3rem;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .cspot__card:hover .cspot__qv,
  .cspot__qv:focus-visible { opacity: 1; transform: translateY(0); }
  @media (hover: none) {
    .cspot__qv { opacity: 1; transform: translateY(0); } /* always visible on touch */
  }
  .cspot__vendor {
    margin: 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 1.1rem;
    opacity: 0.55;
  }
  .cspot__title {
    margin: 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.6rem;
    font-weight: 700;
  }
  .cspot__price {
    margin: 0;
    font-size: 1.5rem;
    opacity: 0.9;
  }
  .cspot__price-sale { color: rgb(var(--color-foreground)); }
  .cspot__price-was { opacity: 0.5; margin-inline-start: 0.6rem; }

  @media screen and (min-width: 990px) {
    .cspot__grid {
      grid-template-columns: minmax(26rem, 1fr) 2.6fr;
      gap: 4rem;
    }
    .cspot__intro {
      position: sticky;
      top: 12rem;
    }
    /* Show exactly 3 cards in the slider column; the rest scroll. */
    .cspot__card {
      width: calc((100% - 3.2rem) / 3);
      max-width: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Collection spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "side", "label": "Text beside products" },
        { "value": "top", "label": "Heading on top, slider below" }
      ],
      "default": "side"
    },
    {
      "type": "header",
      "content": "Text panel"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The SS26 Drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your new go-to fits"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Heavyweight tees and hoodies, built for the heat and the late nights. Limited runs — once they're gone, they're gone."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Collection spotlight"
    }
  ]
}
{% endschema %}
