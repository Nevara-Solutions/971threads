{%- comment -%}
  971threads — Full-bleed hero slideshow (Berlin-style).
  Centered statement headline (Anton via --font-display-family), gradient scrim, ghost CTA
  with arrow, prev/next arrows + dot pagination, optional autoplay. Each slide is a block.
  Falls back to bundled tee/hoodie images when a slide has no image picked.
{%- endcomment -%}

{%- liquid
  case section.settings.height
    when 'small'
      assign vh = 60
    when 'medium'
      assign vh = 75
    when 'large'
      assign vh = 88
    else
      assign vh = 100
  endcase
  assign slide_count = section.blocks.size
-%}

{%- style -%}
  #hero-{{ section.id }} {
    --hero-vh: {{ vh }}svh;
    --hero-scrim: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<hero-slideshow
  id="hero-{{ section.id }}"
  class="hero hero--{{ section.settings.text_align }} color-{{ section.settings.color_scheme }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="hero__viewport">
    <div class="hero__track">
      {%- assign fallbacks = 'tee-black-model.jpg,hoodie-grey-back.jpg,ldc-apparel-6.jpg' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign fb = forloop.index0 | modulo: fallbacks.size -%}
        {%- assign fb_image = fallbacks[fb] -%}
        <div class="hero__slide" {{ block.shopify_attributes }}>
          <div class="hero__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  sizes: '100vw',
                  widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
                  class: 'hero__img'
              }}
            {%- else -%}
              <img
                src="{{ fb_image | asset_url }}"
                alt=""
                class="hero__img"
                loading="eager"
                fetchpriority="high"
                width="1600"
                height="1067"
              >
            {%- endif -%}
            <span class="hero__scrim"></span>
          </div>

          <div class="hero__inner page-width">
            <div class="hero__content">
              {%- if block.settings.kicker != blank -%}
                <p class="hero__kicker">{{ block.settings.kicker }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="hero__sub">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: '#' }}" class="hero__btn">
                  <span>{{ block.settings.button_label }}</span>
                  <svg class="hero__btn-arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17 17 7M9 7h8v8" stroke-linecap="square" />
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if slide_count > 1 -%}
    <button class="hero__arrow hero__arrow--prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5 8 12l7 7" stroke-linecap="square"/></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m9 5 7 7-7 7" stroke-linecap="square"/></svg>
    </button>
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</hero-slideshow>

{%- stylesheet -%}
  .hero {
    position: relative;
    display: block;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--hero-vh);
    color: #fff;
  }
  .hero__viewport {
    overflow: hidden;
    min-height: var(--hero-vh);
  }
  .hero__track {
    display: flex;
    min-height: var(--hero-vh);
    transition: transform 0.6s cubic-bezier(0.65, 0.05, 0.36, 1);
  }
  .hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: var(--hero-vh);
    display: flex;
    align-items: center;
  }
  .hero--left .hero__slide { align-items: flex-end; }
  .hero__media,
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__img { object-fit: cover; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,calc(var(--hero-scrim) + 0.2)) 0%,
      rgba(0,0,0,var(--hero-scrim)) 50%,
      rgba(0,0,0,calc(var(--hero-scrim) * 0.5)) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 7rem;
    padding-bottom: 7rem;
  }
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .hero--center .hero__content {
    max-width: 90rem;
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }
  .hero--left .hero__content { max-width: 62rem; }
  .hero__kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 1.4rem;
    opacity: 0.9;
  }
  .hero__heading {
    margin: 0;
    font-family: var(--font-display-family);
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0.01em;
    font-size: clamp(4rem, 7vw, 8.5rem);
    text-shadow: 0 2px 30px rgba(0,0,0,0.35);
  }
  .hero__sub {
    margin: 0;
    font-size: clamp(1.5rem, 1.6vw, 1.9rem);
    letter-spacing: 0.04em;
    max-width: 52ch;
    opacity: 0.95;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.2rem;
    padding: 1.4rem 2.8rem;
    background: #000;
    border: 1.5px solid #000;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1.4rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .hero__btn:hover { background: #fff; border-color: #fff; color: #000; }
  .hero__btn-arrow { flex-shrink: 0; }

  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.85);
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .hero__arrow:hover { color: #fff; }
  .hero__arrow--prev { left: 0.6rem; }
  .hero__arrow--next { right: 0.6rem; }

  .hero__dots {
    position: absolute;
    bottom: 2.4rem;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .hero__dot {
    width: 0.9rem;
    height: 0.9rem;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.45);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .hero__dot.is-active { background: #fff; transform: scale(1.25); }

  @media screen and (max-width: 749px) {
    .hero__inner { padding-top: 4rem; padding-bottom: 5rem; }
    .hero__arrow { width: 3.4rem; height: 3.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__track { transition: none; }
  }
{%- endstylesheet -%}

<script src="{{ 'hero-slideshow.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image darken",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use a built-in tee/hoodie image."
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker (small label)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "No basics just statement pieces"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Look good and feel great with everyday pieces that balance style and comfort."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
