{%- comment -%}
  971threads — Feature/benefits row. Icon + heading + text columns. Each block = one feature.
{%- endcomment -%}

{%- style -%}
  #frow-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --frow-cols: {{ section.blocks.size | at_least: 1 }};
  }
{%- endstyle -%}

<section id="frow-{{ section.id }}" class="frow color-{{ section.settings.color_scheme }} gradient">
  <div class="frow__inner">
    {%- for block in section.blocks -%}
      <div class="frow__item" {{ block.shopify_attributes }}>
        <span class="frow__icon">
          {%- case block.settings.icon -%}
            {%- when 'shipping' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7l9-4 9 4-9 4-9-4Zm0 0v10l9 4 9-4V7M12 11v10" stroke-linejoin="round"/></svg>
            {%- when 'shirt' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3 4 6l2 3 2-1v10h8V8l2 1 2-3-4-3-2 2H10L8 3Z" stroke-linejoin="round"/></svg>
            {%- when 'grid' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="2.4"/><circle cx="17" cy="7" r="2.4"/><circle cx="7" cy="17" r="2.4"/><circle cx="17" cy="17" r="2.4"/></svg>
            {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12a8 8 0 1 1 2.3 5.6M4 12V7m0 5h5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="10" width="14" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17.8 6.6 20l1-6.1L3.2 9.5l6.1-.9L12 3Z" stroke-linejoin="round"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
          {%- endcase -%}
        </span>
        {%- if block.settings.heading != blank -%}<h3 class="frow__title">{{ block.settings.heading }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<p class="frow__text">{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{%- stylesheet -%}
  .frow__inner { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-inline: var(--page-gutter); border-top: 0.1rem solid rgba(var(--color-foreground), 0.12); padding-top: 4rem; }
  .frow__item { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.2rem; padding: 1rem; }
  .frow__icon svg { width: 4rem; height: 4rem; }
  .frow__title { margin: 0; font-family: var(--font-heading-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.6rem; }
  .frow__text { margin: 0; max-width: 32ch; opacity: 0.75; line-height: 1.55; font-size: 1.4rem; }
  @media screen and (min-width: 750px) {
    .frow__inner { grid-template-columns: repeat(var(--frow-cols), 1fr); }
    .frow__item:not(:last-child) { border-inline-end: 0.1rem solid rgba(var(--color-foreground), 0.12); }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Feature row",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping box" },
            { "value": "shirt", "label": "T-shirt" },
            { "value": "grid", "label": "Grid / design" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure" },
            { "value": "star", "label": "Star" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Worldwide shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wherever you are, we ship the 971 to your door — fast and tracked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature row",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shipping", "heading": "Worldwide shipping", "text": "Wherever you are, we ship the 971 to your door — fast and tracked." } },
        { "type": "feature", "settings": { "icon": "shirt", "heading": "Heavyweight quality", "text": "Premium heavyweight cotton tees and hoodies, built to last drop after drop." } },
        { "type": "feature", "settings": { "icon": "grid", "heading": "Limited drops", "text": "Every release is a limited run — no restocks, no repeats." } }
      ]
    }
  ]
}
{% endschema %}
