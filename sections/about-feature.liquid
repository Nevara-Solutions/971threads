{%- comment -%}
  971threads — About section with switchable tabs + image. Each block = a tab (label + text).
{%- endcomment -%}

{%- style -%}
  #about-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<section id="about-{{ section.id }}" class="about color-{{ section.settings.color_scheme }} gradient">
  <div class="about__grid">
    <div class="about__content">
      {%- if section.settings.kicker != blank -%}<p class="about__kicker">{{ section.settings.kicker }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="about__tabs">
          {%- for block in section.blocks -%}
            <button type="button" class="about__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index0 }}">
              <span class="about__mark">&lt;&gt;</span>{{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
        <div class="about__panels">
          {%- for block in section.blocks -%}
            <p class="about__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="about__btn">
          <span>{{ section.settings.button_label }}</span>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="square"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="about__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width:990px) 45vw, 100vw', widths: '600,900,1200,1400', class: 'about__img' }}
      {%- else -%}
        <img src="{{ 'tee-graphic-cream.jpg' | asset_url }}" alt="" class="about__img" loading="lazy" width="1200" height="1500">
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'about-tabs.js' | asset_url }}" defer></script>

{%- stylesheet -%}
  .about__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; padding-inline: var(--page-gutter); }
  .about__kicker { margin: 0 0 2rem; text-transform: uppercase; letter-spacing: 0.28em; font-size: 1.2rem; font-weight: 600; opacity: 0.6; }
  .about__tabs { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.4rem; }
  .about__tab { background: none; border: none; cursor: pointer; text-align: left; font-family: var(--font-heading-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; font-size: clamp(1.8rem, 2.4vw, 2.6rem); color: rgba(var(--color-foreground), 0.4); transition: color 0.15s ease; padding: 0; }
  .about__tab.is-active { color: rgb(var(--color-foreground)); }
  .about__mark { font-family: var(--font-body-family); font-weight: 400; font-size: 0.6em; opacity: 0.5; margin-inline-end: 0.8rem; }
  .about__panels { position: relative; min-height: 9rem; margin-bottom: 2.6rem; }
  .about__panel { margin: 0; max-width: 42ch; line-height: 1.6; opacity: 0.82; display: none; }
  .about__panel.is-active { display: block; }
  .about__btn { display: inline-flex; align-items: center; gap: 0.7rem; padding: 1.3rem 2.6rem; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); border: 1.5px solid rgb(var(--color-foreground)); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.3rem; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
  .about__btn:hover { background: #fff; color: #000; border-color: #000; }
  .about__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media screen and (min-width: 990px) {
    .about__grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .about__media { aspect-ratio: 4 / 5; }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "About Us" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Mission" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "971 Threads makes heavyweight tees and hoodies for the streets of the UAE and beyond — built to last, designed to stand out." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About",
      "blocks": [
        { "type": "tab", "settings": { "label": "Mission", "text": "971 Threads makes heavyweight tees and hoodies for the streets of the UAE and beyond — from sands to street, built to last and designed to stand out." } },
        { "type": "tab", "settings": { "label": "Promise", "text": "Premium heavyweight cotton, honest pricing, and limited runs. No mass production, no filler — just fits worth wearing on repeat." } },
        { "type": "tab", "settings": { "label": "Values", "text": "Born in the 971 and made for the culture. We keep drops limited, quality high, and the community first." } }
      ]
    }
  ]
}
{% endschema %}
