{%- # theme-check-disable ValidScopedCSSClass -%}
{%- comment -%}
  971threads — Tabbed collections (Berlin side layout). Heading + description + tabs +
  Shop button on the LEFT; product slider on the RIGHT. Each tab = a block (label +
  collection). Reuses the .cspot__ card + slider styling + Quick View for consistency.
{%- endcomment -%}

{{ 'quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'spotlight-slider.js' | asset_url }}" defer></script>
<script src="{{ 'collection-tabs.js' | asset_url }}" defer></script>

{%- style -%}
  #ctabs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- assign first_block = section.blocks.first -%}
<section id="ctabs-{{ section.id }}" class="ctabs color-{{ section.settings.color_scheme }} gradient">
  <div class="ctabs__grid">
    <div class="ctabs__intro">
      {%- if section.settings.heading != blank -%}<h2 class="ctabs__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<p class="ctabs__desc">{{ section.settings.description }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="ctabs__tabs" role="tablist">
          {%- for block in section.blocks -%}
            {%- assign c = block.settings.collection -%}
            <button
              type="button"
              class="ctabs__tab{% if forloop.first %} is-active{% endif %}"
              data-tab="{{ forloop.index0 }}"
              data-shop-label="{{ block.settings.button_label | escape }}"
              data-shop-link="{{ block.settings.button_link | default: c.url | default: '#' }}"
              {{ block.shopify_attributes }}
            >{{ block.settings.label }}</button>
            {%- unless forloop.last -%}<span class="ctabs__sep" aria-hidden="true">/</span>{%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if first_block -%}
        <a class="ctabs__shop" href="{{ first_block.settings.button_link | default: first_block.settings.collection.url | default: '#' }}">
          <span>{{ first_block.settings.button_label }}</span>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="square"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="ctabs__panels">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <div class="ctabs__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index0 }}">
          <div class="cspot__slider">
            <button class="cspot__arrow cspot__arrow--prev" type="button" aria-label="Previous"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 5 8 12l7 7" stroke-linecap="square"/></svg></button>
            <div class="cspot__viewport">
              <div class="cspot__row">
                {%- if c != blank and c.products.size > 0 -%}
                  {%- for product in c.products limit: section.settings.products_to_show -%}
                    {%- render 'mini-product-card', product: product, sub: c.title -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..4) -%}
                    <div class="cspot__card cspot__card--placeholder">
                      <div class="cspot__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'cspot__img placeholder' }}</div>
                      <div class="cspot__info"><h3 class="cspot__title">Product title</h3><p class="cspot__price">AED 0.00</p></div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
            <button class="cspot__arrow cspot__arrow--next" type="button" aria-label="Next"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 5 7 7-7 7" stroke-linecap="square"/></svg></button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .ctabs__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-inline: var(--page-gutter); }
  .ctabs__heading { margin: 0 0 1.2rem; font-family: var(--font-heading-family); font-weight: 700; text-transform: uppercase; letter-spacing: -0.01em; font-size: clamp(2.6rem, 3.4vw, 4rem); }
  .ctabs__desc { margin: 0 0 2rem; opacity: 0.75; line-height: 1.5; max-width: 40ch; }
  .ctabs__tabs { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.4rem; }
  .ctabs__tab { background: none; border: none; padding: 0; cursor: pointer; font-family: var(--font-heading-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 1.5rem; color: rgba(var(--color-foreground), 0.4); transition: color 0.15s ease; }
  .ctabs__tab.is-active { color: rgb(var(--color-foreground)); text-decoration: underline; text-underline-offset: 0.5rem; text-decoration-thickness: 0.15rem; }
  .ctabs__sep { opacity: 0.3; }
  .ctabs__shop { display: inline-flex; align-items: center; gap: 0.7rem; padding: 1.3rem 2.6rem; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); border: 1.5px solid rgb(var(--color-foreground)); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; font-size: 1.3rem; text-decoration: none; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .ctabs__shop:hover { background: #fff; color: #000; border-color: #000; }
  .ctabs__panel { display: none; }
  .ctabs__panel.is-active { display: block; }
  /* Cards per view: 1 (mobile, with a peek) -> 2 (tablet) -> 3 (desktop). */
  .ctabs .cspot__card { width: 85%; max-width: none; }
  @media screen and (min-width: 750px) {
    .ctabs .cspot__card { width: calc((100% - 1.6rem) / 2); }
  }
  @media screen and (min-width: 990px) {
    .ctabs__grid { grid-template-columns: minmax(26rem, 1fr) 2.6fr; gap: 4rem; align-items: start; }
    .ctabs__intro { position: sticky; top: 12rem; }
    .ctabs .cspot__card { width: calc((100% - 3.2rem) / 3); }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Collection tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover the latest drop — heavyweight tees and hoodies, built from sands to street." },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Hoodies" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "button_label", "label": "Shop link label", "default": "Shop hoodies" },
        { "type": "url", "id": "button_link", "label": "Shop link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Hoodies", "button_label": "Shop hoodies" } },
        { "type": "tab", "settings": { "label": "T-shirts", "button_label": "Shop tees" } }
      ]
    }
  ]
}
{% endschema %}
